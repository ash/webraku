# The Webraku demos at web.raku.online — generated by `rakupp demo/run.raku caddy web.raku.online`
# from demo/demos.txt. Each demo strips its own mount, so the path is passed on as it is.
web.raku.online {
    encode zstd gzip

    redir /sudoku /sudoku/ permanent
    handle /sudoku/* {
        reverse_proxy 127.0.0.1:8801
    }

    redir /unicode /unicode/ permanent
    handle /unicode/* {
        reverse_proxy 127.0.0.1:8802
    }

    redir /pixels /pixels/ permanent
    handle /pixels/* {
        reverse_proxy 127.0.0.1:8803
    }

    redir /wavelet /wavelet/ permanent
    handle /wavelet/* {
        reverse_proxy 127.0.0.1:8804
    }

    redir /sieve /sieve/ permanent
    handle /sieve/* {
        reverse_proxy 127.0.0.1:8805
    }

    redir /counter /counter/ permanent
    handle /counter/* {
        reverse_proxy 127.0.0.1:8806
    }

    handle {
        reverse_proxy 127.0.0.1:8800
    }
}
