#!/usr/bin/env rakupp
# monarch — build and run a Monarch application.
#
#   monarch build app.raku          # write app.client.js beside it
#   monarch run   app.raku [--port=8080] [--dev]
#   monarch bundle app.raku         # print the assembled Raku, without transpiling
#
# `build` is the step that makes one file into two programs. It concatenates the
# framework's browser half with the application, replaces every `is server` body
# with a call to the RPC stub, appends the mount call, and hands the result to
# `rakupp --target=js --standalone`.
use lib $?FILE.IO.parent.parent.add('lib').Str;
use Monarch::Bundle;

my $ROOT = $?FILE.IO.parent.parent;
my $LIB  = $ROOT.add('lib');

sub part(Str $rel --> Str) {
    my $f = $LIB.add($rel);
    die "monarch: $rel is missing from {$LIB}" unless $f.e;
    strip-uses($f.slurp);
}

#| The whole browser program, as one file of Raku.
sub assemble(IO::Path $app --> Str) {
    my $src = $app.slurp;
    my @out;
    @out.push: '# Generated by `monarch build` — do not edit.';
    @out.push: "# The browser half of {$app.basename}: the framework, then the program with";
    @out.push: '# every `is server` body replaced by the call that fetches it.';
    @out.push: 'use JS;';
    @out.push: '';
    @out.push: part('Monarch/HTML.rakumod');
    @out.push: part('Monarch/Route.rakumod');
    @out.push: part('Monarch/JSON.rakumod');
    @out.push: part('Monarch/Client.rakumod');
    @out.push: part('Monarch/Rpc.rakumod');
    @out.push: '';
    @out.push: '# ---- the application ----';
    # `serve` and `stylesheet` belong to the server; the browser never runs them.
    # `page` is kept, and the mount below picks the one matching the URL.
    my $client = stub-server-subs(strip-uses($src));
    $client = drop-server-calls($client);
    @out.push: $client;
    @out.push: '';
    @out.push: '# ---- mount ----';
    @out.push: 'monarch-hydrate();';
    @out.join("\n");
}

#| Remove the statements that only make sense on the server: `serve …;` and
#| `stylesheet …;`. A dropped line may OPEN A HEREDOC — `stylesheet q:to/CSS/;`
#| is how a page's styles are written — and the body then has to go with it, or
#| the CSS is left behind as loose Raku and the file stops parsing at the end.
sub drop-server-calls(Str $src --> Str) {
    my @out;
    my @lines = $src.lines;
    my $i = 0;
    while $i < @lines {
        my $l = @lines[$i];
        my $server-only = $l ~~ / ^ \s* 'serve' <[\s;(:]> /
                       || $l ~~ / ^ \s* 'stylesheet' <[\s;(]> /;
        unless $server-only {
            @out.push: $l;
            $i++;
            next;
        }
        @out.push: '# (a server-only statement was dropped here)';
        # `q:to/MARK/`, `qq:to/MARK/`, `Q:to[MARK]` — take the body and its
        # terminator too.
        if $l ~~ / <[qQ]> <[qQ]>? ':to' <[\/\[\{\|]> \s* (<[\w\-]>+) / {
            my $mark = ~$0;
            $i++;
            while $i < @lines && @lines[$i].trim ne $mark { $i++ }
        }
        $i++;
    }
    @out.join("\n");
}

sub client-js(IO::Path $app, Bool :$keep-raku = False --> Str) {
    my $bundle = assemble($app);
    my $tmp = $app.parent.add($app.basename.subst(/ '.raku' $ /, '') ~ '.client.raku');
    $tmp.spurt: $bundle;
    my $out = $app.parent.add($app.basename.subst(/ '.raku' $ /, '') ~ '.client.js');
    my $p = run $*EXECUTABLE.Str, '--target=js', '--standalone', $tmp.Str, '-o', $out.Str, :out, :err;
    my $err = $p.err.slurp(:close);
    $p.out.slurp(:close);
    unless $p.exitcode == 0 {
        note $err;
        note "monarch: the browser half did not transpile. The assembled Raku is at $tmp";
        exit 1;
    }
    $tmp.unlink unless $keep-raku;
    $out.slurp;
}

multi sub MAIN('build', Str $app, Bool :$keep-raku = False) {
    my $f = $app.IO;
    die "monarch: no such file $app" unless $f.e;
    my $js = client-js($f, :$keep-raku);
    say "monarch: {$f.basename.subst(/'.raku'$/, '')}.client.js — {$js.chars} characters";
}

multi sub MAIN('bundle', Str $app) {
    print assemble($app.IO);
}

multi sub MAIN('run', Str $app, Int :$port = 8080, Bool :$dev = False, Bool :$keep-raku = False) {
    my $f = $app.IO;
    die "monarch: no such file $app" unless $f.e;
    my $js = client-js($f, :$keep-raku);
    # The application declares its routes when it is run, and its own `serve`
    # call starts the server. It is handed the bundle through the environment
    # so that the program itself stays free of build concerns.
    %*ENV<MONARCH_CLIENT_JS_FILE> = $f.parent.add($f.basename.subst(/'.raku'$/, '') ~ '.client.js').Str;
    %*ENV<MONARCH_PORT> = $port.Str;
    %*ENV<MONARCH_DEV>  = $dev ?? '1' !! '';
    my $p = run $*EXECUTABLE.Str, '-I', $LIB.Str, $f.Str;
    exit $p.exitcode;
}

multi sub MAIN() {
    say q:to/USAGE/;
    monarch — build and run a Monarch application

      monarch build  app.raku              write app.client.js beside it
      monarch run    app.raku [--port=N] [--dev]
      monarch bundle app.raku              print the assembled browser Raku

    --dev       reload the page when the program changes
    --keep-raku keep the assembled .client.raku, to read or to transpile by hand
    USAGE
}
